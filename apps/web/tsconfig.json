{
  "include": [
    "app/**/*",
    "scripts/**/*.ts",
    "test/auth.test.ts",
    "test/auth-pool.test.ts",
    "test/reset-diagnostics.test.ts",
    "test/recovered-dashboard.test.ts",
    "test/workspace.test.ts",
    "test/wizard-samples.test.ts",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "baseUrl": ".",
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
